<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fallback font-extension for Arial (also registered in JasperArialFontConfig).
  Prefer putting TTFs in fonts/arial/ or set jasper.fonts.arial-dir.
-->
<fontFamilies>
	<fontFamily name="Arial">
		<normal>fonts/arial/arial.ttf</normal>
		<bold>fonts/arial/arialbd.ttf</bold>
		<italic>fonts/arial/ariali.ttf</italic>
		<boldItalic>fonts/arial/arialbi.ttf</boldItalic>
		<pdfEncoding>Identity-H</pdfEncoding>
		<pdfEmbedded>true</pdfEmbedded>
	</fontFamily>
</fontFamilies>
